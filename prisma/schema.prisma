generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HoyoGame {
  GENSHIN
  HONKAI_STAR_RAIL
  ZENLESS_ZONE_ZERO
}

enum NewsType {
  BROADCAST
  PV
  UPDATE
  EVENT
}

model Chore {
  id           String       @id @default(cuid())
  game         HoyoGame
  name         String
  intervalDays Int          @default(1)
  streak       Int          @default(0)
  lastDoneAt   DateTime?
  completions  Completion[]
  createdAt    DateTime     @default(now())
}

/// One row per chore per local calendar day it was completed.
model Completion {
  id        String   @id @default(cuid())
  choreId   String
  chore     Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([choreId, date])
}

model News {
  id        String   @id @default(cuid())
  game      HoyoGame
  type      NewsType @default(UPDATE)
  title     String
  date      DateTime
  url       String?
  createdAt DateTime @default(now())
}
